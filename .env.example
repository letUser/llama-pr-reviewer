# PR reviewer config — copy to .env and edit.
# Sourced by review-pr, review-queue, and scan-open-prs at startup.
# Uncommented values reflect script defaults; commented lines show the knob exists.

# ====== REQUIRED ======

# GitHub org/user that owns the repos being reviewed.
OWNER=""

# Space-separated list of repo names under $OWNER to scan (used by scan-open-prs).
REPOS="repo-one repo-two"

# URL of running llama-server OpenAI-compatible endpoint.
LLAMA_URL="http://127.0.0.1:8082"

# Model name advertised by llama-server (matches --alias / model file).
LLAMA_MODEL="local-qwen"

# ====== OPTIONAL ======

# Restart llama-server (systemd --user unit) between queue batches to free VRAM.
# 0 = skip, 1 = restart. Requires LLAMA_UNIT below.
RESTART_LLAMA="0"

# systemd --user unit name; only needed when RESTART_LLAMA=1.
# LLAMA_UNIT="qwen-server"

# scan-open-prs scanner window: only consider PRs created within last N hours.
LOOKBACK_HOURS="12"

# scan-open-prs base-ref filters (comma-separated).
# Skip PRs whose base ref matches any exact name or any listed prefix.
SKIP_BASE_REFS="main,master"
SKIP_BASE_PREFIXES="release/"

# Override data dir (where .cache, .share live). Default: script dir.
# PR_REVIEWER_HOME=""

# Override workspace base (clone location). Default: $PR_REVIEWER_HOME/.share.
# WORKSPACE_BASE=""

# Path to review-pr used by review-queue. Defaults to sibling in same dir.
# WORKER="$HOME/.local/bin/review-pr"

# openclaw channel name. Any channel openclaw supports (telegram, whatsapp, etc).
NOTIFY_CHANNEL="telegram"

# Notification target ID (chat/user/room ID) for queue-start/done notifications.
# Sent via `openclaw message send`. Empty = no notify.
# NOTIFY_TARGET=""

# GitHub login of a verifier bot to @-mention at end of review (no @).
# VERIFY_BOT=""

# GitHub login of bot owner to @-mention (no @).
# BOT_OWNER=""

# Comma-separated bot logins whose prior comments are excluded from model context.
# SKIP_PRIOR_AUTHORS="botuser1,botuser2"

# Comma-separated GitHub logins whose PRs we skip entirely (e.g. own PRs).
# SKIP_AUTHORS="gituser1,gituser2"

# ====== BUDGET TUNING ======
MAX_DIFF_BYTES="240000"
OVERSIZE_DIFF_BYTES="360000" # Hard cap: skip model, request human review, @-mention BOT_OWNER.
MAX_PR_BODY_BYTES="1500"
HUNK_CONTEXT_LINES="3" # Default 3 (git/gh standard); avoid >5 — bloats tokens.
MAX_SYMBOLS="15"
MAX_CALLERS_PER_SYMBOL="3"
MAX_COMMENT_BODY="200"

# llama-server context window. Must satisfy prompt + MAX_TOKENS + CTX_SAFETY_MARGIN.
CTX_SIZE="131072"

# Output token cap (n_predict). Reasoning models burn tokens before answer —
# bump up MAX_TOKENS if you see "missing Conclusion line / finish_reason=length".
MAX_TOKENS="24576"
CTX_SAFETY_MARGIN="2048"

MAX_TITLE_LEN="60"
